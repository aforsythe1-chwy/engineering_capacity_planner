# Copy to .env.offline.local. Keep the password file outside this repository.
ECP_DATA_SOURCE=jira-store
ECP_JIRA_STORE_PATH=./packages/backend/testdata/team-board.jira-store.enc
# Password defaults to the Personal 1Password item configured in source, so no
# password setting is needed here. Use this only to override it for a shared vault.
# ECP_JIRA_STORE_PASSWORD_FILE=/absolute/path/outside/repository/jira-store-password.txt
# ECP_JIRA_STORE_PASSWORD_OP_REF=op://YOUR_VAULT/YOUR_ITEM_UUID/password
ECP_DB_PATH=./packages/backend/data/offline-jira.db
ECP_SEED_IF_EMPTY=true
