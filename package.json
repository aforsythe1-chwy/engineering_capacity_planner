{
  "name": "engineering-capacity-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Local, single-user engineering capacity / sprint-planning tool. Projects epic dev-complete dates against configurable team capacity and renders a red/yellow/green feasibility verdict.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "packages/engine",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:local": "npm run seed:local --workspace @ecp/backend",
    "seed:jira": "npm run seed:jira --workspace @ecp/backend",
    "export:fixture": "npm run export:fixture --workspace @ecp/backend",
    "export:obfuscated": "npm run export:obfuscated --workspace @ecp/backend",
    "jira-store:capture": "npm run jira-store:capture --workspace @ecp/backend",
    "jira-store:verify": "npm run jira-store:verify --workspace @ecp/backend",
    "jira-store:inspect": "npm run jira-store:verify --workspace @ecp/backend",
    "jira-store:diff": "npm run jira-store:diff --workspace @ecp/backend",
    "jira-store:reset-db": "npm run jira-store:reset-db --workspace @ecp/backend",
    "dev:offline": "ECP_ENV_FILE=.env.offline.local npm run dev",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace @ecp/backend\" \"npm run dev --workspace @ecp/frontend\"",
    "dev:backend": "npm run dev --workspace @ecp/backend",
    "dev:frontend": "npm run dev --workspace @ecp/frontend",
    "e2e": "npm run e2e --workspace @ecp/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
